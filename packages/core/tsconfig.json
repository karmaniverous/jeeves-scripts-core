{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "types": [
      "node",
      "vitest/globals"
    ]
  },
  "include": [
    "src/**/*",
    "scripts/**/*",
    "test/**/*",
    "legacy.test.ts",
    "rollup.config.ts",
    "vitest.config.ts"
  ],
  "exclude": [
    "dist",
    "node_modules",
    "template",
    "src/admin/**/*",
    "src/email/**/*",
    "src/github/**/*",
    "src/google-drive/**/*",
    "src/jira/**/*",
    "src/meetings/**/*",
    "src/x/**/*"
  ]
}
