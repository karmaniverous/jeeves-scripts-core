{
  "name": "@karmaniverous/jeeves-scripts-core",
  "version": "0.1.0",
  "author": "Jason Williscroft",
  "description": "Shared Jeeves scripts domains, runnable registry and CLI for jeeves-scripts instance repos.",
  "license": "BSD-3-Clause",
  "type": "module",
  "files": [
    "dist",
    "template",
    "config",
    "jobs",
    "guides",
    "skills",
    "schema",
    "presets",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./cli": {
      "import": {
        "types": "./dist/cli/index.d.ts",
        "default": "./dist/cli/index.js"
      }
    },
    "./package.json": "./package.json",
    "./guides/*": "./guides/*",
    "./schema/*": "./schema/*",
    "./config/*": "./config/*",
    "./skills/*": "./skills/*",
    "./presets/*.js": {
      "types": "./dist/presets/*.d.ts",
      "default": "./dist/presets/*.js"
    },
    "./presets/*": "./presets/*"
  },
  "types": "dist/index.d.ts",
  "bin": {
    "jeeves-scripts": "dist/cli/bin.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/karmaniverous/jeeves-scripts-core.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/karmaniverous/jeeves-scripts-core/issues"
  },
  "homepage": "https://github.com/karmaniverous/jeeves-scripts-core#readme",
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@commander-js/extra-typings": "^15.0.0",
    "@karmaniverous/jeeves": "^0.6.0",
    "@karmaniverous/jeeves-runner": "^0.11.0",
    "@xdevplatform/xdk": "^0.6.6",
    "commander": "^15.0.0",
    "cross-spawn": "^7.0.6",
    "date-fns": "^4.4.0",
    "fast-json-patch": "^3.1.1",
    "imapflow": "^2.4.0",
    "jsonpath-plus": "^11.2.0",
    "mailparser": "^3.9.38",
    "mammoth": "^1.13.0",
    "officeparser": "^8.1.1",
    "pdf-parse": "^2.4.5",
    "puppeteer-core": "^25.13.0",
    "read-excel-file": "^9.3.12",
    "tsx": "^4.23.15",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "^2.34.2",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@types/cross-spawn": "^6.0.6",
    "@types/fs-extra": "^11.0.4",
    "@types/mailparser": "^3.9.0",
    "@types/node": "^26.6.5",
    "cross-env": "^10.1.0",
    "fs-extra": "^11.4.1",
    "release-it": "^21.1.1",
    "rollup": "^4.64.5",
    "tslib": "^2.8.1",
    "vitest": "^5.0.3"
  },
  "scripts": {
    "build": "rimraf dist && cross-env NO_COLOR=1 rollup --config rollup.config.ts && tsx scripts/write-schema.ts && tsx scripts/copy-template.ts",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "changelog": "git-cliff -o CHANGELOG.md",
    "release": "dotenvx run -f .env.local -- release-it",
    "release:pre": "dotenvx run -f .env.local -- release-it --no-git.requireBranch --github.preRelease --preRelease"
  }
}
