{
  "name": "jeeves-scripts-template",
  "version": "0.0.0",
  "private": true,
  "description": "A Jeeves scripts instance repo: configuration, overrides and instance runnables on @karmaniverous/jeeves-scripts-core.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "check": "node bin/jeeves-scripts.js config check",
    "doctor": "node bin/jeeves-scripts.js doctor",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@karmaniverous/jeeves-scripts-core": "*"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.0.4",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4"
  }
}
